---
import { SITE_URL, HI_LIVE, SEO_DEFAULTS, crumbsFor } from '../lib/constants';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  locale: 'en' | 'hi';
  path: string;
  title?: string;
  description?: string;
}
const { locale, path, title, description } = Astro.props;
const meta = SEO_DEFAULTS[locale];
const canonical = `${SITE_URL}${path}`;
const mirrorPath = locale === 'en'
  ? '/hi' + (path === '/' ? '/' : path)
  : (path.replace(/^\/hi/, '') || '/');

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'HinglishToHindi',
  url: SITE_URL,
  logo: `${SITE_URL}/logo.svg`,
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'contact@openpixal.com',
    contactType: 'customer support',
    availableLanguage: ['English', 'Hindi'],
  },
};
const crumbs = crumbsFor(path);
const breadcrumbJsonLd = crumbs ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: locale === 'en' ? 'Home' : 'होम', item: SITE_URL },
    ...crumbs[locale].map((name, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name,
      item: `${SITE_URL}${path}`,
    })),
  ],
} : null;
---
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? meta.title}</title>
    <meta name="description" content={description ?? meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en-IN" href={`${SITE_URL}${locale === 'en' ? path : mirrorPath}`} />
    {HI_LIVE && <link rel="alternate" hreflang="hi-IN" href={`${SITE_URL}${locale === 'hi' ? path : mirrorPath}`} />}
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? meta.title} />
    <meta property="og:description" content={description ?? meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale === 'en' ? 'en_IN' : 'hi_IN'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? meta.title} />
    <meta name="twitter:description" content={description ?? meta.description} />
    <meta name="twitter:image" content={`${SITE_URL}/logo.jpeg`} />
    <meta name="theme-color" content="#4F39F6" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/logo.jpeg" />
    <meta property="og:image" content={`${SITE_URL}/logo.jpeg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    {breadcrumbJsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6933862407017280" crossorigin="anonymous"></script>
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased dark:bg-slate-950 dark:text-slate-100">
    <header><Navbar locale={locale} path={path} /></header>
    <main><slot /></main>
    <Footer locale={locale} />
  </body>
</html>
