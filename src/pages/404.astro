---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout locale="en" path="/404/">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="text-6xl font-bold text-indigo-600">404</h1>
    <p class="mt-4 text-xl font-medium">Page Not Found</p>
    <p class="mt-2 text-slate-600 dark:text-slate-300">
      The page you're looking for doesn't exist.
    </p>
    <p class="mt-6">
      <a href="/" class="rounded-md bg-indigo-600 px-6 py-3 font-medium text-white hover:bg-indigo-700">
        Go Home
      </a>
    </p>
  </div>
</BaseLayout>
