---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout locale="hi" path="/hi/404/">
  <div class="mx-auto max-w-3xl px-4 py-20 text-center">
    <h1 class="text-6xl font-bold text-indigo-600">404</h1>
    <p class="mt-4 text-xl font-medium">पृष्ठ नहीं मिला</p>
    <p class="mt-2 text-slate-600 dark:text-slate-300">
      आप जिस पृष्ठ को खोज रहे हैं वह मौजूद नहīं है।
    </p>
    <p class="mt-6">
      <a href="/hi/" class="rounded-md bg-indigo-600 px-6 py-3 font-medium text-white hover:bg-indigo-700">
        होम पर जाएं
      </a>
    </p>
  </div>
</BaseLayout>
